000358r 1  C9 2E        	CMP #DOT
00035Ar 1  D0 0C        	BNE @ERR
00035Cr 1  A2 05        	LDX #NUMDIR
00035Er 1  A5 0C        	LDA MNE+1
000360r 1  DD rr rr     @NEXT	CMP DIRS-1,X
000363r 1  F0 09        	BEQ @FDIR
000365r 1  CA           	DEX
000366r 1  D0 F8        	BNE @NEXT
000368r 1  68           @ERR	PLA
000369r 1  A0 01        	LDY #INVMNE
00036Br 1  4C rr rr     	JMP SHWERR
00036Er 1  CA           @FDIR	DEX
00036Fr 1  A8           @FOUND	TAY		; put mnemonic/directive code in Y
000370r 1  C8           	INY		; offset by 1 so no code $00
000371r 1  68           	PLA		; restore Y
000372r 1  AA           	TAX
000373r 1  94 00        	STY IOBUF,X
000375r 1  E8           	INX
000376r 1  A9 0F        	LDA #ARGS
000378r 1  85 50        	STA MISCL
00037Ar 1               ;	LDA #EOFLD
00037Ar 1               ;	STA TEMP1
00037Ar 1  20 rr rr     	JSR TKNISE
00037Dr 1  86 2F        	STX XSAV
00037Fr 1  E6 2F        	INC XSAV
000381r 1  A9 1D        	LDA #COMM
000383r 1  85 50        ISCMNT	STA MISCL
000385r 1  A9 00        	LDA #EOL
000387r 1  85 54        	STA TEMP1
000389r 1  85 55        	STA TEMP2
00038Br 1  20 rr rr     	JSR TKNISE
00038Er 1  E4 2F        	CPX XSAV
000390r 1  D0 03        	BNE @RET
000392r 1  CA           	DEX		; no args or comments, so stop early
000393r 1  95 FF        	STA <(IOBUF-1),X	; A already holds $00
000395r 1  60           @RET 	RTS
000396r 1               
000396r 1               ONEFLD			; do one entry field
000396r 1               			; A holds the end point for the field
000396r 1  85 54        	STA TEMP1	; last position
000398r 1  20 rr rr     @NEXT	JSR NEXTCH	; catches ESC, CR and BS
00039Br 1  90 FB        	BCC @NEXT	; only allow legal keys
00039Dr 1  20 EF FF     	JSR OUTCH	; echo
0003A0r 1  95 00        	STA IOBUF,X
0003A2r 1  E8           	INX
0003A3r 1  C9 20        	CMP #SP
0003A5r 1  F0 05        	BEQ @FILL
0003A7r 1  E4 54        	CPX TEMP1
0003A9r 1  D0 ED        	BNE @NEXT
0003ABr 1  60           @RET	RTS
0003ACr 1  A5 54        @FILL	LDA TEMP1
0003AEr 1  F0 E8        	BEQ @NEXT	; just treat a space normally
0003B0r 1  E4 54        	CPX TEMP1	; fill spaces
0003B2r 1  F0 F7        	BEQ @RET
0003B4r 1  A9 20        	LDA #SP
0003B6r 1  95 00        	STA IOBUF,X

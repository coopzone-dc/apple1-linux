000EB3r 1               PRDASH
000EB3r 1  A9 2D        	LDA #MINUS
000EB5r 1  4C EF FF     	JMP OUTCH
000EB8r 1               
000EB8r 1               ; ****************************************
000EB8r 1               
000EB8r 1               	.if MINIMONITOR
000EB8r 1  20 rr rr     GETCH1	JSR GETCH
000EBBr 1  4C EF FF     	JMP OUTCH
000EBEr 1               	.endif
000EBEr 1               
000EBEr 1               ; ****************************************
000EBEr 1               
000EBEr 1               SHWMOD			; Show name of module being assembled
000EBEr 1  20 rr rr     	JSR CRLF
000EC1r 1  A2 00        	LDX #$00
000EC3r 1  B5 04        @LOOP2	LDA LABEL,X
000EC5r 1  20 EF FF     	JSR OUTCH
000EC8r 1  E8           	INX
000EC9r 1  E0 06        	CPX #LBLSZ
000ECBr 1  D0 F6        	BNE @LOOP2
000ECDr 1  20 rr rr     	JSR OUTSP
000ED0r 1               ;	JMP PRLNNM	; falls through
000ED0r 1               
000ED0r 1               ; ****************************************
000ED0r 1               
000ED0r 1               PRLNNM
000ED0r 1  A5 FB        	LDA LINEH
000ED2r 1  20 E5 FF     	JSR PRHEX
000ED5r 1  A5 FA        	LDA LINEL
000ED7r 1  20 DC FF     	JSR OUTHEX
000EDAr 1               	;JMP OUTSP
000EDAr 1               ; falls through
000EDAr 1               
000EDAr 1               OUTSP
000EDAr 1  A9 20        	LDA #SP
000EDCr 1  4C EF FF     	JMP OUTCH
000EDFr 1               
000EDFr 1               CRLF			; Go to a new line.
000EDFr 1  A9 0D        	LDA #CR		; "CR"
000EE1r 1  20 EF FF     	JSR OUTCH
000EE4r 1  A9 0A        	LDA #LF		; "LF" - is this needed for the Apple 1?
000EE6r 1  4C EF FF     	JMP OUTCH
000EE9r 1               
000EE9r 1               	.if APPLE1
000EE9r 1               ; ****************************************
000EE9r 1               
000EE9r 1               GETCH			; wait for a key, return it in A with bit 7 clear
000EE9r 1  AD 11 D0     	LDA KBDRDY
000EECr 1  10 FB        	BPL GETCH
000EEEr 1  AD 10 D0     	LDA KBD
000EF1r 1  29 7F        	AND #INMASK
000EF3r 1  C9 5F        	CMP #$5F	; Apple 1 rubout key ('_', as in WOZMON and BASIC)
000EF5r 1  D0 02        	BNE @GRET
000EF7r 1  A9 08        	LDA #BS		; ...is Krusader's backspace
000EF9r 1  60           @GRET	RTS
000EFAr 1               	.endif

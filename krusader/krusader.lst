000346r 1  BD rr rr     	LDA RMNETB-1,X
000349r 1  C5 57        	CMP RMNE
00034Br 1  F0 03        	BEQ @FND
00034Dr 1  CA           @NXT	DEX
00034Er 1  D0 EF        	BNE @LOOP

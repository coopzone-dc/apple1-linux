000307r 1               ; falls through
000307r 1               
000307r 1               ; ****************************************
000307r 1               
000307r 1               TOTKN			; tokenise to IOBUF to calc size
000307r 1               			; then move memory to make space
000307r 1               			; then copy from IOBUF into the space
000307r 1  A2 00        	LDX #$00
000309r 1  86 51        	STX MISCH
00030Br 1  A9 20        	LDA #SP
00030Dr 1  85 55        	STA TEMP2
00030Fr 1  A9 04        	LDA #LABEL
000311r 1  85 50        	STA MISCL
000313r 1  A9 01        	LDA #EOFLD
000315r 1  85 54        	STA TEMP1
000317r 1  20 rr rr     	JSR TKNISE
00031Ar 1  A4 04        	LDY LABEL
00031Cr 1  C0 3B        	CPY #CMNT
00031Er 1  D0 04        	BNE @CONT
000320r 1  A9 0B        	LDA #MNE
000322r 1  D0 5F        	BNE ISCMNT	; always branches
000324r 1  8A           @CONT	TXA		; save X
000325r 1  48           	PHA
000326r 1               
000326r 1               ;	JSR SRCHMN	; is it a mnemonic?
000326r 1               
000326r 1               SRCHMN  		; Search the table of mnemonics	for the mnemonic in MNE
000326r 1               			; Return the index in A
000326r 1               
000326r 1               CMPMNE			; compress the 3 char mnemonic
000326r 1               			; at MNE to MNE+2 into 2 chars
000326r 1               			; at LMNE and RMNE
000326r 1  18           	CLC
000327r 1  66 56        	ROR LMNE
000329r 1  A2 03        	LDX #$03
00032Br 1  38           @NEXT2	SEC
00032Cr 1  B5 0A        	LDA MNE-1,X
00032Er 1  E9 40        	SBC #'A'-1
000330r 1  A0 05        	LDY #$05
000332r 1  4A           @LOOP2	LSR
000333r 1  66 56        	ROR LMNE
000335r 1  66 57        	ROR RMNE
000337r 1  88           	DEY
000338r 1  D0 F8        	BNE @LOOP2
00033Ar 1  CA           	DEX
00033Br 1  D0 EE        	BNE @NEXT2
00033Dr 1               
00033Dr 1  A2 38        	LDX #NUMMN	; Number of mnemonics
00033Fr 1  BD rr rr     @LOOP	LDA LMNETB-1,X
000342r 1  C5 56        	CMP LMNE

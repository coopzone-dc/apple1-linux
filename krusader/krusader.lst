000996r 1               			; #ABY		$nnnn,Y
000996r 1               			; #IND		($nnnn)
000996r 1               			; #IDX		($nn,X)
000996r 1               			; #IDY		($nn),Y
000996r 1               			; #INZ		($nn)
000996r 1               			; #IAX		($nnnn,X)
000996r 1               ;
000996r 1               ;	Addressing modes are organised as follows:
000996r 1               ;
000996r 1               ;	IMP (0)	ZPG (4) INZ (-) ABS (9) IND (C)
000996r 1               ;	ACC (1) ZPX (5) INX (7) ABX (A) IAX (D)
000996r 1               ;	IMM (2) ZPY (6) INY (8) ABY (B) ---
000996r 1               ;	REL (3) ---	 ---	---	---
000996r 1               ;
000996r 1               ;	so algorithm below starts with 4, adds 3 if indirect
000996r 1               ;	and adds 6 if absolute (i.e. 2 byte address), then adds 1 or 2
000996r 1               ;	if ,X or ,Y format
000996r 1               ;
000996r 1  A2 00        	LDX #$00
000998r 1  A9 04        	LDA #$04	; start with mode index of 4
00099Ar 1  B4 0F        	LDY ARGS,X
00099Cr 1  C0 28        	CPY #OPEN
00099Er 1  D0 04        	BNE @SKIP
0009A0r 1  18           	CLC		; add 3 for indirect modes
0009A1r 1  69 03        	ADC #$03
0009A3r 1  E8           	INX
0009A4r 1  48           @SKIP	PHA
0009A5r 1  20 rr rr     	JSR NBYTS	; count bytes (1 or 2 only)
0009A8r 1  A8           	TAY		; byte count in Y
0009A9r 1  CA           	DEX
0009AAr 1  A5 3C        	LDA CURMNE
0009ACr 1  C9 21        	CMP #$21	; is it JSR?
0009AEr 1  F0 04        	BEQ @JSR
0009B0r 1  C9 23        	CMP #$23	; is it JMP?
0009B2r 1  D0 01        	BNE @NOJMP
0009B4r 1               @JSR	;LDY #$2		; force 2 bytes for these two situations
0009B4r 1  C8           	INY		; following code treats Y = 3 the same as Y = 2
0009B5r 1  68           @NOJMP	PLA		; mode base back in A
0009B6r 1  E8           	INX		; check for NBYTS failure
0009B7r 1  F0 56        	BEQ FERR
0009B9r 1  88           	DEY
0009BAr 1  F0 03        	BEQ @1BYT
0009BCr 1  18           @2BYT	CLC
0009BDr 1  69 06        	ADC #$06	; add 6 to base index for 2 byte modes
0009BFr 1  A8           @1BYT	TAY		; mode index now in Y
0009C0r 1  B5 0F        @CHECK	LDA ARGS,X
0009C2r 1  F0 04        	BEQ @DONE
0009C4r 1  C9 20        	CMP #SP
0009C6r 1  D0 14        	BNE @CONT
0009C8r 1  A5 0F        @DONE	LDA ARGS
0009CAr 1  C9 28        	CMP #OPEN	; brackets must match
0009CCr 1  F0 41        	BEQ FERR
0009CEr 1  C0 0F        @RET	CPY #$0F
0009D0r 1  10 3D        	BPL FERR	; no indirect absolute Y mode
0009D2r 1  C0 07        	CPY #$07
0009D4r 1  F0 39        	BEQ FERR	; no indirect zero page mode
0009D6r 1  30 01        	BMI @L1		; 6502 has no INZ mode, so reduce
0009D8r 1  88           	DEY		; so reduce by ifgreater than 7
0009D9r 1  98           @L1	TYA
0009DAr 1  AA           	TAX
0009DBr 1  60           	RTS
0009DCr 1  C9 29        @CONT	CMP #CLOSE
0009DEr 1  D0 0B        	BNE @MORE
0009E0r 1  A9 20        	LDA #SP
0009E2r 1  85 0F        	STA ARGS	; erase brackets now they have
0009E4r 1  E8           	INX
0009E5r 1  B5 0F        	LDA ARGS,X
0009E7r 1  C9 2C        	CMP #COMMA
0009E9r 1  D0 D5        	BNE @CHECK
0009EBr 1  B5 0F        @MORE	LDA ARGS,X
0009EDr 1  C9 2C        	CMP #COMMA
0009EFr 1  D0 1E        	BNE FERR
0009F1r 1  E8           	INX
0009F2r 1  B5 0F        	LDA ARGS,X
0009F4r 1  C9 58        	CMP #'X'
0009F6r 1  F0 0D        	BEQ @ISX
0009F8r 1  C9 59        @ISY	CMP #'Y'
0009FAr 1  D0 13        	BNE FERR
0009FCr 1  A5 0F        	LDA ARGS
0009FEr 1  C9 28        	CMP #OPEN
000A00r 1  F0 0D        	BEQ FERR
000A02r 1  95 0D        	STA ARGS-2,X	; to avoid ,X check below
000A04r 1  C8           	INY
000A05r 1  C8           @ISX	INY
000A06r 1  B5 0D        	LDA ARGS-2,X
000A08r 1  C9 29        	CMP #CLOSE
000A0Ar 1  F0 03        	BEQ FERR
000A0Cr 1  E8           	INX
000A0Dr 1  D0 B1        	BNE @CHECK	; always
000A0Fr 1  A2 FF        FERR	LDX #FAIL	; error message generated upstream
000A11r 1  60           FRET	RTS
000A12r 1  A0 00        NBYTS	LDY #$00	; count bytes using Y
000A14r 1  E8           @LOOP	INX
000A15r 1  C8           	INY
000A16r 1  20 rr rr     	JSR AHARGS
000A19r 1  C9 FF        	CMP #FAIL
000A1Br 1  D0 F7        	BNE @LOOP
000A1Dr 1  98           @NEXT	TYA
000A1Er 1  4A           	LSR		; divide number by 2
000A1Fr 1  F0 EE        	BEQ FERR	; zero is an error
000A21r 1  C9 03        	CMP #$03	; 3 or more is an error
000A23r 1  B0 EA        	BCS FERR
000A25r 1  60           @RET	RTS
000A26r 1               
000A26r 1               ; ****************************************
000A26r 1               ; *          Utility Routines            *
000A26r 1               ; ****************************************
000A26r 1               
000A26r 1               SEARCH			; TBLL,H has the address of the table to search
000A26r 1               			; and address of record on successful return
000A26r 1               			; STRL,H has the address of the search string
000A26r 1               			; Search through RECNM records
000A26r 1               			; Each of size RECSZ with RECSIG significant chars
000A26r 1  A5 2C        	LDA RECNM
000A28r 1  F0 E5        	BEQ FERR	; empty table
000A2Ar 1  A2 00        	LDX #$00	; Record number
000A2Cr 1  A0 FF        @CHK1	LDY #$FF	; Index into entry
000A2Er 1  C8           @CHMTCH	INY
000A2Fr 1  C4 2E        	CPY RECSIG	; Have we checked all significant chars?
000A31r 1  F0 DE        	BEQ FRET	; Yes
000A33r 1  B1 40        	LDA (TBLL),Y	; Load the bytes to compare
000A35r 1  D1 42        	CMP (STRL),Y
000A37r 1  F0 F5        	BEQ @CHMTCH	; Check next if these match
000A39r 1  E8           	INX		; Else move to next record
000A3Ar 1  E4 2C        	CPX RECNM
000A3Cr 1  F0 D1        	BEQ FERR
000A3Er 1  A5 40        	LDA TBLL	; Update address
000A40r 1  18           	CLC
000A41r 1  65 2D        	ADC RECSZ
000A43r 1  85 40        	STA TBLL
000A45r 1  90 E5        	BCC @CHK1
000A47r 1  E6 41        	INC TBLH	; Including high byte if necessary
000A49r 1  B0 E1        	BCS @CHK1	; will always branch
000A4Br 1               ;.FAIL	LDX #FAIL	; X = $FF indicates failure
000A4Br 1               ;.MATCH	RTS		; got it - index is in X, address is in A and TBLL,H
000A4Br 1               
000A4Br 1               ; ****************************************
000A4Br 1               
000A4Br 1               BYT2HX			; convert the ASCII byte (1 or 2 chars) at offset X in
000A4Br 1               			; the args field to Hex
000A4Br 1               			; result in A ($FF for fail)
000A4Br 1               
000A4Br 1  20 rr rr     	JSR AHARGS
000A4Er 1  C9 FF        	CMP #FAIL	; indicates conversion error
000A50r 1  F0 BD        	BEQ FERR
000A52r 1  48           	PHA
000A53r 1  20 rr rr     	JSR AHARGS1
000A56r 1  CA           	DEX
000A57r 1  C9 FF        	CMP #FAIL
000A59r 1  D0 02        	BNE @CONT
000A5Br 1  68           	PLA		; just ignore 2nd character
000A5Cr 1  60           	RTS
000A5Dr 1  85 44        @CONT	STA SCRTCH
000A5Fr 1  68           	PLA
000A60r 1  0A           	ASL		; shift
000A61r 1  0A           	ASL
000A62r 1  0A           	ASL
000A63r 1  0A           	ASL
000A64r 1  65 44        	ADC SCRTCH
000A66r 1  60           	RTS
000A67r 1               
000A67r 1               ; ****************************************
000A67r 1               
000A67r 1  E8           AHARGS1	INX		; caller needs to DEX
000A68r 1  B5 0F        AHARGS	LDA ARGS,X
000A6Ar 1               ASC2HX			; convert ASCII code in A to a HEX digit
000A6Ar 1  49 30            	EOR #$30
000A6Cr 1  C9 0A        	CMP #$0A
000A6Er 1  90 08        	BCC @VALID
000A70r 1  69 88        	ADC #$88        ; $89 - CLC
000A72r 1  C9 FA        	CMP #$FA
000A74r 1  90 03        	BCC @ERR
000A76r 1  29 0F        	AND #$0F
000A78r 1  60           @VALID	RTS
000A79r 1  A9 FF        @ERR	LDA #FAIL	; this value can never be from a single digit,
000A7Br 1  60           	RTS		; so ok to indicate error
000A7Cr 1               
000A7Cr 1               ; ****************************************
000A7Cr 1               
000A7Cr 1               HX2ASC			; convert a byte in A into two ASCII characters
000A7Cr 1               			; store in ARGS,Y and ARGS+1,Y
000A7Cr 1  48           	PHA 		; 1st byte.
000A7Dr 1  20 rr rr     	JSR LSR4	; slower, but saves a byte and not too crucial
000A80r 1  20 rr rr     	JSR DO1DIG
000A83r 1  68           	PLA
000A84r 1  29 0F        DO1DIG	AND #$0F	; Print 1 hex digit
000A86r 1  09 30        	ORA #$30
000A88r 1  C9 3A        	CMP #$3A
000A8Ar 1  90 02        	BCC @DONE
000A8Cr 1  69 06        	ADC #$06
000A8Er 1  99 0F 00     @DONE	STA ARGS,Y
000A91r 1  C8           	INY
000A92r 1  60           	RTS
000A93r 1               
000A93r 1               ; ****************************************
000A93r 1               
000A93r 1               EXPMNE			; copy the 2 chars at R/LMNETB,X
000A93r 1               			; into LMNE and RMNE, and expand
000A93r 1               			; into 3 chars at MNE to MNE+2
000A93r 1  BD rr rr     	LDA LMNETB,X
000A96r 1  85 56        	STA LMNE
000A98r 1  BD rr rr     	LDA RMNETB,X
000A9Br 1  85 57        	STA RMNE
000A9Dr 1  A2 00        	LDX #$00
000A9Fr 1  A9 00        @NEXT	LDA #$00
000AA1r 1  A0 05        	LDY #$05
000AA3r 1  06 57        @LOOP	ASL RMNE
000AA5r 1  26 56        	ROL LMNE
000AA7r 1  2A           	ROL
000AA8r 1  88           	DEY
000AA9r 1  D0 F8        	BNE @LOOP
000AABr 1  69 40        	ADC #'A'-1
000AADr 1  95 0B        	STA MNE,X
000AAFr 1  A4 5B        	LDY PRFLAG
000AB1r 1  F0 03        	BEQ @SKIP
000AB3r 1  20 EF FF     	JSR OUTCH	; print the mnemonic as well
000AB6r 1  E8           @SKIP	INX
000AB7r 1  E0 03        	CPX #$03
000AB9r 1  D0 E4        	BNE @NEXT
000ABBr 1  60           	RTS
000ABCr 1               
000ABCr 1               ; ****************************************
000ABCr 1               ;      		DISASSEMBLER
000ABCr 1               ; Adapted from code in a Dr Dobbs article
000ABCr 1               ; by Steve Wozniak and Allen Baum (Sep '76)
000ABCr 1               ; ****************************************
000ABCr 1               
000ABCr 1               DISASM
000ABCr 1  20 rr rr     	JSR ADDARG
000ABFr 1               	;BEQ .DODIS
000ABFr 1  F0 03        	BEQ DSMBL
000AC1r 1  20 rr rr     @COPY	JSR LVTOPC
000AC4r 1               ;.DODIS	JMP DSMBL
000AC4r 1               ; fall through
000AC4r 1               
000AC4r 1               ; ****************************************
000AC4r 1               
000AC4r 1               DSMBL
000AC4r 1               	;LDA #$13	; Count for 20 instruction dsmbly
000AC4r 1               	;STA COUNT
000AC4r 1  20 rr rr     @DSMBL2	JSR INSTDSP	; Disassemble and display instr.
000AC7r 1  20 rr rr     	JSR PCADJ
000ACAr 1  85 F5        	STA PCL		; Update PCL,H to next instr.
000ACCr 1  84 F6        	STY PCH
000ACEr 1               	;DEC COUNT	; Done first 19 instrs
000ACEr 1               	;BNE .DSMBL2	; * Yes, loop.  Else DSMBL 20th
000ACEr 1               
000ACEr 1               	.if APPLE1
000ACEr 1  AD 11 D0     	LDA	KBDRDY	; any key stops the disassembly
000AD1r 1  10 F1        	BPL	@DSMBL2
000AD3r 1  AD 10 D0     	LDA	KBD
000AD6r 1               	.else
000AD6r 1                      LDA     ACIAStatus
000AD6r 1                       AND     #1
000AD6r 1                       BEQ     @DSMBL2
000AD6r 1                       LDA     ACIAData
000AD6r 1               	.endif
000AD6r 1               
000AD6r 1               
000AD6r 1  20 rr rr     INSTDSP	JSR PRPC	; Print PCL,H
000AD9r 1  A1 F5        	LDA (PCL,X)	; Get op code
000ADBr 1  A8           	TAY
000ADCr 1  4A           	LSR   		; * Even/odd test
000ADDr 1  90 09        	BCC @IEVEN
000ADFr 1  6A           	ROR  		; * Test B1
000AE0r 1  B0 14        	BCS @ERR	; XXXXXX11 instr invalid
000AE2r 1  C9 A2        	CMP #$A2
000AE4r 1  F0 10        	BEQ @ERR	; 10001001 instr invalid
000AE6r 1  29 87        	AND #$87	; Mask 3 bits for address mode
000AE8r 1               	;ORA #$80	; * add indexing offset
000AE8r 1  4A           @IEVEN	LSR   		; * LSB into carry for
000AE9r 1  AA           	TAX   		; Left/right test below
000AEAr 1  BD rr rr     	LDA MODE,X	; Index into address mode table
000AEDr 1  90 03        	BCC @RTMODE	; If carry set use LSD for
000AEFr 1  20 rr rr     	JSR LSR4
000AF2r 1               	;LSR   		; * print format index
000AF2r 1               	;LSR
000AF2r 1               	;LSR   		; If carry clear use MSD
000AF2r 1               	;LSR
000AF2r 1  29 0F        @RTMODE	AND #$0F	; Mask for 4-bit index
000AF4r 1  D0 04        	BNE @GETFMT	; $0 for invalid opcodes
000AF6r 1  A0 80        @ERR	LDY #$80	; Substitute $80 for invalid op,
000AF8r 1  A9 00        	LDA #$00	; set print format index to 0
000AFAr 1  AA           @GETFMT	TAX
000AFBr 1  BD rr rr     	LDA MODE2,X	; Index into print format table
000AFEr 1  85 29        	STA FORMAT	; Save for address field format
000B00r 1  29 03        	AND #$03	; Mask 2-bit length.  0=1-byte
000B02r 1  85 2A        	STA LENGTH	; *  1=2-byte, 2=3 byte
000B04r 1  98           	TYA   		; * op code
000B05r 1  20 rr rr     	JSR GETMNE
000B08r 1  A0 00        	LDY #$00
000B0Ar 1  48           	PHA   		; Save mnemonic table index
000B0Br 1  B1 F5        @PROP	LDA (PCL),Y
000B0Dr 1  20 DC FF     	JSR OUTHEX
000B10r 1  A2 01        	LDX #$01
000B12r 1  20 rr rr     @PROPBL	JSR PRBL2
000B15r 1  C4 2A        	CPY LENGTH	; Print instr (1 to 3 bytes)
000B17r 1  C8           	INY   		; *  in a 12-character field
000B18r 1  90 F1        	BCC @PROP
000B1Ar 1  A2 03        	LDX #$03	; char count for mnemonic print
000B1Cr 1  86 5B        	STX PRFLAG	; So EXPMNE prints the mnemonic
000B1Er 1  C0 04        	CPY #$04
000B20r 1  90 F0        	BCC @PROPBL
000B22r 1  68           	PLA   		; Recover mnemonic index
000B23r 1  AA           	TAX
000B24r 1  20 rr rr     	JSR EXPMNE
000B27r 1  20 rr rr     	JSR PRBLNK	; Output 3 blanks
000B2Ar 1  A4 2A        	LDY LENGTH
000B2Cr 1  A2 06        	LDX #$06	; Count for 6 print format bits
000B2Er 1  E0 03        @PPADR1	CPX #$03
000B30r 1  F0 1E        	BEQ @PPADR5	; If X=3 then print address val
000B32r 1  06 29        @PPADR2	ASL FORMAT	; Test next print format bit
000B34r 1  90 0E        	BCC @PPADR3	; If 0 don't print
000B36r 1  BD rr rr     	LDA CHAR1-1,X	; *  corresponding chars
000B39r 1  20 EF FF     	JSR OUTCH	; Output 1 or 2 chars
000B3Cr 1  BD rr rr     	LDA CHAR2-1,X	; *  (If char from char2 is 0,
000B3Fr 1  F0 03        	BEQ @PPADR3	; *   don't output it)
000B41r 1  20 EF FF     	JSR OUTCH
000B44r 1  CA           @PPADR3	DEX
000B45r 1  D0 E7        	BNE @PPADR1
000B47r 1  86 5B        	STX PRFLAG	; reset flag to 0
000B49r 1  60           	RTS  		; Return if done 6 format bits
000B4Ar 1  88           @PPADR4	DEY
000B4Br 1  30 E5        	BMI @PPADR2
000B4Dr 1  20 DC FF     	JSR OUTHEX	; Output 1- or 2-byte address
000B50r 1  A5 29        @PPADR5	LDA FORMAT
000B52r 1  C9 E8        	CMP #$E8	; Handle rel addressing mode
000B54r 1  B1 F5        	LDA (PCL),Y	; Special print target adr
000B56r 1  90 F2        	BCC @PPADR4	; *  (not displacement)
000B58r 1  20 rr rr     @RELADR	JSR PCADJ3	; PCL,H + DISPL + 1 to A,Y
000B5Br 1  AA           	TAX
000B5Cr 1  E8           	INX
000B5Dr 1  D0 01        	BNE PRNTYX	; *     +1 to X,Y
000B5Fr 1  C8           	INY
000B60r 1  98           PRNTYX	TYA
000B61r 1  20 DC FF     PRNTAX	JSR OUTHEX	; Print target adr of branch
000B64r 1  8A           PRNTX	TXA   		; *  and return
000B65r 1  4C DC FF     	JMP OUTHEX
000B68r 1  20 rr rr     PRPC	JSR CRLF	; Output carriage return
000B6Br 1  A5 F6        	LDA PCH
000B6Dr 1  A6 F5        	LDX PCL
000B6Fr 1  20 rr rr     	JSR PRNTAX	; Output PCL and PCH
000B72r 1  A2 03        PRBLNK	LDX #$03	; Blank count
000B74r 1  20 rr rr     PRBL2	JSR OUTSP	; Output a blank
000B77r 1  CA           	DEX
000B78r 1  D0 FA        	BNE PRBL2	; Loop until count = 0
000B7Ar 1  60           	RTS
000B7Br 1  38           PCADJ	SEC
000B7Cr 1  A5 2A        PCADJ2	LDA LENGTH	; 0=1-byte, 1=2-byte, 2=3-byte
000B7Er 1  A4 F6        PCADJ3	LDY PCH
000B80r 1  AA           	TAX   		; * test displ sign (for rel
000B81r 1  10 01        	BPL @PCADJ4	; *  branch).  Extend neg
000B83r 1  88           	DEY   		; *  by decrementing PCH
000B84r 1  65 F5        @PCADJ4	ADC PCL
000B86r 1  90 01        	BCC @RTS		; PCL+LENGTH (or displ) + 1 to A
000B88r 1  C8           	INY   		; *  carry into Y (PCH)
000B89r 1  60           @RTS	RTS
000B8Ar 1               
000B8Ar 1               GETMNE			; get mnemonic index for opcode in A
000B8Ar 1               			; on completion, A holds the index
000B8Ar 1               			; into the mnemonic table
000B8Ar 1  85 54        	STA TEMP1	; will need it later
000B8Cr 1  29 8F        	AND #$8F
000B8Er 1  C9 8A        	CMP #$8A
000B90r 1  F0 43        	BEQ CAT3
000B92r 1  0A           	ASL
000B93r 1  C9 10        	CMP #$10
000B95r 1  F0 37        	BEQ CAT2
000B97r 1  A5 54        	LDA TEMP1	; ? ABCD EFGH - thanks bogax, www.6502.org/forum
000B99r 1  0A           	ASL		; A BCDE FGH0
000B9Ar 1  69 80        	ADC #$80	; B ?CDE FGHA
000B9Cr 1  2A           	ROL		; ? CDEF GHAB
000B9Dr 1  0A           	ASL		; C DEFG HAB0
000B9Er 1  29 1F        	AND #$1F	; C 000G HAB0
000BA0r 1  69 20        	ADC #$20	; 0 001G HABC
000BA2r 1  48           	PHA
000BA3r 1  A5 54        	LDA TEMP1	; get the opcode back
000BA5r 1  29 9F        	AND #$9F
000BA7r 1  F0 1B        	BEQ CAT1
000BA9r 1  0A           	ASL
000BAAr 1  C9 20        	CMP #$20
000BACr 1  F0 10        	BEQ CAT4
000BAEr 1  29 06        	AND #$06
000BB0r 1  D0 2F        	BNE CAT67
000BB2r 1               CAT5			; remaining nnnX XX00 codes
000BB2r 1  68           	PLA
000BB3r 1  29 07        	AND #$07	; just low 3 bits
000BB5r 1  C9 03        	CMP #$03
000BB7r 1  10 02        	BPL @L3
000BB9r 1  69 02        	ADC #$02	; correction for 21 and 22
000BBBr 1  69 1F        @L3	ADC #$1F	; and add 20
000BBDr 1  60           	RTS
000BBEr 1               CAT4			; Branch instructions - nnn1 0000
000BBEr 1  68           	PLA
000BBFr 1  29 07        	AND #$07	; just low 3 bits
000BC1r 1  69 18        	ADC #$18	; and add 19 (carry is set)
000BC3r 1  60           	RTS
000BC4r 1               CAT1			; 0nn0 0000 - BRK, JSR, RTI, RTS
000BC4r 1  68           	PLA
000BC5r 1  AA           	TAX
000BC6r 1  BD rr rr     	LDA MNEDAT-$20,X
000BC9r 1  60           	RTS
000BCAr 1  16 21 17 18  MNEDAT	.byte $16, $21, $17, $18
000BCEr 1               CAT2			; nnnn 1000 - lots of no-arg mnemonics
000BCEr 1  A5 54        	LDA TEMP1
000BD0r 1  4A           LSR4	LSR		; need high 4 bits
000BD1r 1  4A           	LSR
000BD2r 1  4A           	LSR
000BD3r 1  4A           	LSR
000BD4r 1  60           	RTS
000BD5r 1               CAT3			; 1nnn 1010 - TXA,TXS,TAX,TSX,DEX,-,NOP,-
000BD5r 1  20 rr rr     	JSR CAT2	; need high 4 bits
000BD8r 1  C9 0E        	CMP #$0E
000BDAr 1  D0 02        	BNE @L2
000BDCr 1  69 FD        	ADC #$FD
000BDEr 1  69 08        @L2	ADC #$08	; then add 8
000BE0r 1  60           	RTS
000BE1r 1               CAT67			; gets the index for categories 6 and 7

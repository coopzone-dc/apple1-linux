000E1Er 1  20 rr rr     	JSR INSTDSP    ;PRINT USER PC.
000E21r 1  4C rr rr     	JMP GETCMD
000E24r 1               	.if DOTRACE
000E24r 1  18           XRTI    CLC
000E25r 1  68                   PLA              ;SIMULATE RTI BY EXPECTING
000E26r 1  85 F0                STA SAVP     ;  STATUS FROM STACK, THEN RTS
000E28r 1  68           XRTS    PLA              ;RTS SIMULATION
000E29r 1  85 F5                STA PCL        ;  EXTRACT PC FROM STACK
000E2Br 1  68                   PLA              ;  AND UPDATE PC BY 1 (LEN=0)
000E2Cr 1  85 F6        PCINC2  STA PCH
000E2Er 1  20 rr rr     PCINC3  JSR PCADJ2	;UPDATE PC BY LEN
000E31r 1  84 F6                STY PCH
000E33r 1  18                   CLC
000E34r 1  90 14                BCC NEWPCL
000E36r 1  18           XJSR    CLC
000E37r 1  20 rr rr             JSR PCADJ2     ;UPDATE PC AND PUSH
000E3Ar 1  AA                   TAX              ;  ONTO STACK FOR
000E3Br 1  98                   TYA              ;  JSR SIMULATE
000E3Cr 1  48                   PHA
000E3Dr 1  8A                   TXA
000E3Er 1  48                   PHA
000E3Fr 1  A0 02                LDY #$02
000E41r 1  18           XJMP    CLC
000E42r 1  B1 F5        XJMPAT  LDA (PCL),Y
000E44r 1  AA                   TAX              ;LOAD PC FOR JMP,
000E45r 1  88                   DEY              ;  (JMP) SIMULATE.
000E46r 1  B1 F5                LDA (PCL),Y
000E48r 1  86 F6                STX PCH
000E4Ar 1  85 F5        NEWPCL  STA PCL
000E4Cr 1  B0 F3                BCS XJMP
000E4Er 1  4C rr rr     	JMP XBRK
000E51r 1                       .endif
000E51r 1  20 rr rr     SHOW  	JSR CRLF
000E54r 1  A2 05        	LDX #NREGS
000E56r 1  BD rr rr     @LOOP	LDA DBGCMD-1,X
000E59r 1  20 EF FF     	JSR OUTCH
000E5Cr 1  20 rr rr     	JSR PRDASH
000E5Fr 1  B5 EF        	LDA REGS-1,X
000E61r 1  20 DC FF     	JSR OUTHEX
000E64r 1  20 rr rr     	JSR OUTSP
000E67r 1  CA           	DEX
000E68r 1  D0 EC        	BNE @LOOP
000E6Ar 1  A5 F0        	LDA SAVP	; show the flags explicitly as well
000E6Cr 1  A2 08        	LDX #$08
000E6Er 1  0A           @NEXT	ASL
000E6Fr 1  90 08        	BCC @SKIP
000E71r 1  48           	PHA
000E72r 1  BD rr rr     	LDA FLAGS-1,X
000E75r 1  20 EF FF     	JSR OUTCH
000E78r 1  68           	PLA
000E79r 1  CA           @SKIP	DEX
000E7Ar 1  D0 F2        	BNE @NEXT
000E7Cr 1  60           	RTS
000E7Dr 1               	.if DOTRACE
000E7Dr 1  18           BRANCH  CLC              ;BRANCH TAKEN,
000E7Er 1  A0 01                LDY #$01       ;  ADD LEN+2 TO PC
000E80r 1  B1 F5                LDA (PCL),Y
000E82r 1  20 rr rr             JSR PCADJ3
000E85r 1  85 F5                STA PCL
000E87r 1  98                   TYA
000E88r 1  38           	SEC
000E89r 1  B0 A1                BCS PCINC2
000E8Br 1  20 rr rr     NBRNCH  JSR SAVE       ;NORMAL RETURN AFTER
000E8Er 1  38                   SEC              ;  XEQ USER OF
000E8Fr 1  B0 9D                BCS PCINC3     ;GO UPDATE PC
000E91r 1  EA           INITBL  NOP
000E92r 1  EA                   NOP              ;DUMMY FILL FOR
000E93r 1  4C rr rr             JMP NBRNCH     ;  XEQ AREA
000E96r 1  4C rr rr             JMP BRANCH
000E99r 1                       .endif
000E99r 1  A5 F0        RESTORE LDA SAVP     ;RESTORE 6502 REG CONTENTS
000E9Br 1  48                   PHA              ;  USED BY DEBUG SOFTWARE
000E9Cr 1  A5 F4                LDA SAVA
000E9Er 1  A6 F3        	LDX SAVX
000EA0r 1  A4 F2                LDY SAVY
000EA2r 1  28                   PLP
000EA3r 1  60                   RTS
000EA4r 1  85 F4        SAVE    STA SAVA        ;SAVE 6502 REG CONTENTS
000EA6r 1  86 F3        	STX SAVX
000EA8r 1  84 F2                STY SAVY

000000r 1               ; ca65 conversion of Krusader 1.3 (Apple 1 build).
000000r 1               ; Assemble:  ca65 -t none krusader.s -o krusader.o -l krusader.lst
000000r 1               ;            ld65 -C krusader.cfg krusader.o -o krusader.bin
000000r 1               	.setcpu "6502"
000000r 1               	.feature labels_without_colons
000000r 1               
000000r 1               ; KRUSADER - An Assembly Language IDE for the Replica 1
000000r 1               
000000r 1               ; 6502 Version 1.3 - 23 December, 2007
000000r 1               ; (c) Ken Wessen (ken.wessen@gmail.com)
000000r 1               
000000r 1               ; Notes:
000000r 1               ;	- 11 bytes free (17 free if TABTOSPACE = 0)
000000r 1               ;	- Entry points:
000000r 1               ;		SHELL = $711C($F01C)
000000r 1               ;		MOVEDN = $7304($F204)
000000r 1               ;		DEBUG = -($FE14)
000000r 1               ;		XBRK = -($FE1E) - debugger re-entry point
000000r 1               ;		DSMBL = $7BCA($FACA)
000000r 1               
000000r 1               APPLE1  =1
000000r 1               INROM	=1
000000r 1               TABTOSPACE = 0	; the emulator already turns Tab into a space
000000r 1               UNK_ERR_CHECK = 0
000000r 1               
000000r 1               MINIMONITOR = INROM & 1
000000r 1               DOTRACE = MINIMONITOR & 1
000000r 1               BRKAS2 = 1		; if 1, BRK will assemble to two $00 bytes
000000r 1               			; if set, then minimonitor will work unchanged
000000r 1               
000000r 1               ESCAPE = $FF06
000000r 1               	.if APPLE1
000000r 1               KBD	=$D010		; Apple 1 keyboard data (bit 7 set)
000000r 1               KBDRDY	=$D011		; Apple 1 keyboard control (bit 7 set when key waiting)
000000r 1               	.else
000000r 1               GETCH = $DFE8		; Replica 1 ROM getch routine
000000r 1               	.endif
000000r 1               			; for both hardware and software interrupts
000000r 1               ; Apple 1 I/O values
000000r 1               OUTCH	=$FFEF		; Apple 1 Echo
000000r 1               PRHEX	=$FFE5		; Apple 1 Echo
000000r 1               OUTHEX	=$FFDC		; Apple 1 Print Hex Byte Routine
000000r 1               ;KBD     =$D010		; Apple 1 Keyboard character read.
000000r 1               ;KBDRDY  =$D011		; Apple 1 Keyboard data waiting when negative.
000000r 1               
000000r 1               	.segment "CODE"	; linked at $7100 (see krusader.cfg); use $F000 for the INROM build
000000r 1               
000000r 1               	.if INROM
000000r 1               MONTOR	=ESCAPE
000000r 1               GETLINE	=$FF12
000000r 1               	.ELSE
000000r 1               MONTOR	=$FF1F
000000r 1               GETLINE	=MONTOR		; doesn't work in RAM version because needs adjusted monitor code
000000r 1               	.endif
000000r 1               
000000r 1               ; Constants
000000r 1               
000000r 1               ACIA = $A000
000000r 1               ACIAControl = ACIA+0
000000r 1               ACIAStatus = ACIA+0
000000r 1               ACIAData = ACIA+1
000000r 1               
000000r 1               BS	=$08		; backspace
000000r 1               SP	=$20		; space
000000r 1               CR	=$0D		; carriage return
000000r 1               LF	=$0A		; line feed
000000r 1               ESC	=$1B		; escape
000000r 1               INMASK  =$7F
000000r 1               
000000r 1               LNMSZ	=$03
000000r 1               LBLSZ	=$06		; labels are up to 6 characters
000000r 1               MNESZ	=$03		; mnemonics are always 3 characters
000000r 1               ARGSZ	=$0E		; arguments are up to 14 characters
000000r 1               COMSZ	=$0A		; comments fill the rest - up to 10 characters
000000r 1               
000000r 1               ENDLBL	=LNMSZ+LBLSZ+1
000000r 1               ENDMNE	=ENDLBL+MNESZ+1
000000r 1               ENDARG	=ENDMNE+ARGSZ+1
000000r 1               ENDLN	=ENDARG+COMSZ+1
000000r 1               
000000r 1               SYMSZ	=$06		; size of labels
000000r 1               
000000r 1               LINESZ	=$27		; size of a line
000000r 1               USESZ	=LINESZ-LNMSZ-1	; usable size of a line
000000r 1               CNTSZ	=COMM-LABEL-1	; size of content in a line
000000r 1               
000000r 1               MAXSYM	=$20		; at most 32 local symbols (256B) and
000000r 1               MAXFRF	=$55		; 85 forward references (896B)
000000r 1               			; globals are limited by 1 byte index => max of 256 (2K)
000000r 1               			; global symbol table grows downwards
000000r 1               
000000r 1               ; Symbols used in source code
000000r 1               
000000r 1               IMV	='#'		; Indicates immediate mode value
000000r 1               HEX	='$'		; Indicates a hex value
000000r 1               OPEN	='('		; Open bracket for indirect addressing
000000r 1               CLOSE	=')'		; Close bracket for indirect addressing
000000r 1               PC	='*'		; Indicates PC relative addressing
000000r 1               LOBYTE	='<'		; Indicates lo-byte of following word
000000r 1               HIBYTE	='>'		; Indicates hi-byte of following word
000000r 1               PLUS	='+'		; Plus in simple expressions
000000r 1               MINUS	='-'		; Minus in simple expressions
000000r 1               DOT	='.'		; Indicates a local label
000000r 1               QUOTE	=$27		; delimits a string
000000r 1               COMMA	=','
000000r 1               CMNT	=';'		; indicates a full line comment
000000r 1               
000000r 1               PROMPT	='?'
000000r 1               
000000r 1               EOL	=$00		; end of line marker
000000r 1               EOFLD	=$01		; end of field in tokenised source line
000000r 1               BLANK	=$02		; used to mark a blank line
000000r 1               
000000r 1               PRGEND	=$FE		; used to flag end of program parsing
000000r 1               FAIL	=$FF		; used to flag failure in various searches
000000r 1               
000000r 1               ; Zero page storage
000000r 1               IOBUF	=$00		; I/O buffer for source code input and analysis
000000r 1               LABEL	=$04		; label starts here
000000r 1               MNE	=$0B		; mnemonic starts here
000000r 1               ARGS	=$0F		; arguments start here
000000r 1               CHFLG	=$1C		;store for simulate key pressed in BASIC
000000r 1               COMM    =$1D		; comments start here
000000r 1               FREFTL	=$29		; address of forward reference table
000000r 1               FREFTH	=$2A
000000r 1               NFREF	=$2B		; number of forward symbols
000000r 1               RECNM	=$2C		; number of table entries
000000r 1               RECSZ	=$2D		; size of table entries
000000r 1               RECSIG	=$2E		; significant characters in table entries
000000r 1               XSAV	=$2F
000000r 1               YSAV	=$30
000000r 1               CURMNE	=$3C		; Holds the current mne index
000000r 1               CURADM	=$3D		; Holds the current addressing mode
000000r 1               LVALL	=$3E		; Storage for a label value
000000r 1               LVALH	=$3F
000000r 1               TBLL	=$40		; address of search table
000000r 1               TBLH	=$41
000000r 1               STRL	=$42		; address of search string
000000r 1               STRH	=$43
000000r 1               SCRTCH	=$44		; scratch location
000000r 1               NPTCH	=$45		; counts frefs when patching
000000r 1               PTCHTL	=$46		; address of forward reference being patched
000000r 1               PTCHTH	=$47
000000r 1               FLGSAV	=$48
000000r 1               
000000r 1               MISCL	=$50		; Miscellaneous address pointer
000000r 1               MISCH	=$51
000000r 1               MISC2L	=$52		; And another
000000r 1               MISC2H	=$53
000000r 1               TEMP1	=$54		; general purpose storage
000000r 1               TEMP2	=$55
000000r 1               TEMP3	=$56
000000r 1               TEMP4	=$57
000000r 1               LMNE	=TEMP3		; alias for compression and expansion routines
000000r 1               RMNE	=TEMP4
000000r 1               FRFLAG	=$58		; if nonzero, disallow forward references
000000r 1               ERFLAG	=$59		; if nonzero, do not report error line
000000r 1               HADFRF	=$5A		; if nonzero, handled a forward reference
000000r 1               PRFLAG	=$5B
000000r 1               
000000r 1               ; want these to persist if possible when going into the monitor
000000r 1               ; to test code etc, so put them right up high
000000r 1               XQT	=$E0
000000r 1               
000000r 1               ; these 6 locations must be contiguous
000000r 1               GSYMTL	=$E9		; address of the global symbol table
000000r 1               GSYMTH	=$EA
000000r 1               NGSYM	=$EB		; number of global symbols
000000r 1               LSYMTL	=$EC		; address of the local symbol table
000000r 1               LSYMTH	=$ED
000000r 1               NLSYM	=$EE		; number of local symbols
000000r 1               
000000r 1               ; these 7 locations must be contiguous
000000r 1               REGS	=$F0
000000r 1               SAVP	=REGS
000000r 1               SAVS	=$F1
000000r 1               SAVY	=$F2
000000r 1               SAVX	=$F3
000000r 1               SAVA	=$F4
000000r 1               CURPCL	=$F5		; Current PC
000000r 1               CURPCH	=$F6
000000r 1               
000000r 1               CODEH	=$F8		; hi byte of code storage area (low is $00)
000000r 1               TABLEH	=$F9		; hi byte of symbol table area
000000r 1               
000000r 1               ; these 4 locations must be contiguous
000000r 1               LINEL	=$FA		; Current source line number (starts at 0)
000000r 1               LINEH	=$FB
000000r 1               CURLNL	=$FC		; Current source line address
000000r 1               CURLNH	=$FD
000000r 1               
000000r 1               SRCSTL	=$FE		; source code start address
000000r 1               SRCSTH	=$FF
000000r 1               
000000r 1               ; for disassembler
000000r 1               FORMAT	=FREFTL		; re-use spare locations
000000r 1               LENGTH	=FREFTH
000000r 1               COUNT	=NFREF
000000r 1               PCL	=CURPCL
000000r 1               PCH	=CURPCH
000000r 1               
000000r 1               ; ****************************************
000000r 1               ; 	COMMAND SHELL/EDITOR CODE
000000r 1               ; ****************************************
000000r 1               
000000r 1               MAIN
000000r 1               	.if INROM
000000r 1  A9 03        	LDA #$03
000002r 1  85 F8        	STA CODEH
000004r 1  A9 20        	LDA #$20
000006r 1  85 FF        	STA SRCSTH
000008r 1  A9 7C        	LDA #$7C
00000Ar 1  85 F9        	STA TABLEH
00000Cr 1               	.else
00000Cr 1               	LDA #$03
00000Cr 1               	STA CODEH
00000Cr 1               	LDA #$1D
00000Cr 1               	STA SRCSTH
00000Cr 1               	LDA #$6D
00000Cr 1               	STA TABLEH
00000Cr 1               	.endif
00000Cr 1  A2 1B        	LDX #MSGSZ
00000Er 1  BD rr rr     @NEXT	LDA MSG-1,X
000011r 1  20 EF FF     	JSR OUTCH
000014r 1  CA           	DEX
000015r 1  D0 F7        	BNE @NEXT
000017r 1  CA           	DEX
000018r 1  9A           	TXS		; reset stack pointer on startup
000019r 1  20 rr rr     	JSR SHINIT	; default source line and address data
00001Cr 1               ;	JMP SHELL
00001Cr 1               ; falls through to SHELL
00001Cr 1               
00001Cr 1               ; ****************************************
00001Cr 1               
00001Cr 1               SHELL			; Loops forever
00001Cr 1               			; also the re-entry point
00001Cr 1  D8           	CLD		; just incase
00001Dr 1  A9 00        	LDA #$00
00001Fr 1  85 5B        	STA PRFLAG
000021r 1  20 rr rr     	JSR FILBUF
000024r 1  A2 0F        	LDX #ARGS
000026r 1  86 58        	STX FRFLAG	; set flags in SHELL
000028r 1  86 59        	STX ERFLAG
00002Ar 1  20 rr rr     	JSR CRLF
00002Dr 1  A9 3F        	LDA #PROMPT
00002Fr 1  20 EF FF     	JSR OUTCH	; prompt
000032r 1  20 rr rr     	JSR OUTSP	; can drop this if desperate for 3 more bytes :-)
000035r 1  20 rr rr     @KEY	JSR GETCH
000038r 1  C9 08        	CMP #BS
00003Ar 1  F0 E0        	BEQ SHELL	; start again
00003Cr 1  C9 0D        	CMP #CR
00003Er 1  F0 08        	BEQ @RUN
000040r 1  20 EF FF     	JSR OUTCH
000043r 1  95 00        	STA IOBUF,X
000045r 1  E8           	INX
000046r 1  D0 ED        	BNE @KEY	; always branches
000048r 1  A5 0F        @RUN	LDA ARGS
00004Ar 1  F0 D0        	BEQ SHELL	; empty command line
00004Cr 1  A5 10        	LDA ARGS+1	; ensure command is just a single letter
00004Er 1  F0 04        	BEQ @OK
000050r 1  C9 20        	CMP #SP
000052r 1  D0 0C        	BNE @ERR;SHLERR
000054r 1  A2 0D        @OK	LDX #NUMCMD
000056r 1  BD rr rr     @NEXT	LDA CMDS-1,X	; find the typed command
000059r 1  C5 0F        	CMP ARGS
00005Br 1  F0 0E        	BEQ GOTCMD
00005Dr 1  CA           	DEX
00005Er 1  D0 F6        	BNE @NEXT
000060r 1  48           @ERR	PHA		; put dummy data on the stack
000061r 1  48           	PHA
000062r 1               SHLERR
000062r 1  A0 03        	LDY #SYNTAX
000064r 1  68           ERR2	PLA		; need to clean up the stack
000065r 1  68           	PLA
000066r 1  20 rr rr     	JSR SHWERR
000069r 1  D0 B1        	BNE SHELL
00006Br 1  20 rr rr     GOTCMD	JSR RUNCMD
00006Er 1  4C rr rr     	JMP SHELL	; ready for next command
000071r 1               
000071r 1               ; ****************************************
000071r 1               
000071r 1               SHINIT
000071r 1  A9 00        	LDA #$00
000073r 1  A8           	TAY
000074r 1  85 FE        	STA SRCSTL	; low byte zero for storage area
000076r 1  91 FE        	STA (SRCSTL),Y	; and put a zero in it for EOP
000078r 1               TOSTRT			; set LINEL,H and CURLNL,H to the start
000078r 1  A5 FF        	LDA SRCSTH
00007Ar 1  85 FD        	STA CURLNH
00007Cr 1  A9 00        	LDA #$00
00007Er 1  85 FA        	STA LINEL
000080r 1  85 FB        	STA LINEH	; 0 lines
000082r 1  85 FC        	STA CURLNL
000084r 1  60           	RTS		; leaves $00 in A
000085r 1               
000085r 1               ; ****************************************
000085r 1               
000085r 1               PANIC
000085r 1  20 rr rr     	JSR SHINIT
000088r 1  A5 11        	LDA ARGS+2
00008Ar 1  D0 02        	BNE @SKIP
00008Cr 1  A9 01        	LDA #$01
00008Er 1  91 FE        @SKIP	STA (SRCSTL),Y	; Y is $00 from SHINIT
000090r 1  60           	RTS
000091r 1               
000091r 1               ; ****************************************
000091r 1               
000091r 1               VALUE
000091r 1  20 rr rr     	JSR ADDARG
000094r 1  F0 CC        	BEQ SHLERR
000096r 1  20 rr rr     	JSR CRLF
000099r 1  A5 3F        	LDA LVALH
00009Br 1  A6 3E        	LDX LVALL
00009Dr 1  4C rr rr     	JMP PRNTAX
0000A0r 1               
0000A0r 1               ; ****************************************
0000A0r 1               
0000A0r 1               RUN
0000A0r 1  20 rr rr     	JSR ADDARG
0000A3r 1  F0 BD        	BEQ SHLERR
0000A5r 1  20 rr rr     	JSR CRLF
0000A8r 1  6C 3E 00     	JMP (LVALL)	; jump to the address
0000ABr 1               
0000ABr 1               ; ****************************************
0000ABr 1               
0000ABr 1               ADDARG			; convert argument to address
0000ABr 1  A2 02        	LDX #$02
0000ADr 1  B5 0F        	LDA ARGS,X
0000AFr 1  F0 08        	BEQ @NOARG
0000B1r 1  48           	PHA
0000B2r 1  20 rr rr     	JSR EVAL
0000B5r 1  68           	PLA
0000B6r 1               	;CPX #FAIL
0000B6r 1  E8           	INX
0000B7r 1  F0 AB        	BEQ ERR2;SHLERR
0000B9r 1  60           @NOARG	RTS
0000BAr 1               
0000BAr 1               ; ****************************************
0000BAr 1               
0000BAr 1               PCTOLV
0000BAr 1  A5 F5        	LDA CURPCL
0000BCr 1  85 3E        	STA LVALL
0000BEr 1  A5 F6        	LDA CURPCH
0000C0r 1  85 3F        	STA LVALH
0000C2r 1  60           	RTS
0000C3r 1               
0000C3r 1               ; ****************************************
0000C3r 1               
0000C3r 1               LVTOPC
0000C3r 1  A5 3E        	LDA LVALL
0000C5r 1  85 F5        	STA CURPCL
0000C7r 1  A5 3F        	LDA LVALH
0000C9r 1  85 F6        	STA CURPCH
0000CBr 1  60           	RTS
0000CCr 1               
0000CCr 1               ; ****************************************
0000CCr 1               
0000CCr 1               FILLSP
0000CCr 1  A9 20        	LDA #SP
0000CEr 1               FILBUF			; fill the buffer with the contents of A
0000CEr 1  A2 27        	LDX #LINESZ
0000D0r 1  95 FF        @CLR	STA <(IOBUF-1),X
0000D2r 1  CA           	DEX
0000D3r 1  D0 FB        	BNE @CLR
0000D5r 1  60           	RTS
0000D6r 1               
0000D6r 1               ; ****************************************
0000D6r 1               
0000D6r 1               RUNCMD
0000D6r 1  BD rr rr     	LDA CMDH-1,X
0000D9r 1  48             	PHA
0000DAr 1  BD rr rr       	LDA CMDL-1,X
0000DDr 1  48             	PHA
0000DEr 1  60             	RTS
0000DFr 1               
0000DFr 1               ; ****************************************
0000DFr 1               
0000DFr 1               NEW
0000DFr 1  20 rr rr     	JSR SHINIT
0000E2r 1  4C rr rr     	JMP INSERT
0000E5r 1               
0000E5r 1               ; ****************************************
0000E5r 1               
0000E5r 1               LIST			; L 	- list all
0000E5r 1               			; L nnn - list from line nnn
0000E5r 1  20 rr rr     	JSR TOSTRT
0000E8r 1  20 rr rr     	JSR GETARG
0000EBr 1  F0 03        	BEQ @NEXT	; no args, list from start
0000EDr 1  20 rr rr     	JSR GOTOLN	; deal with arguments if necessary
0000F0r 1  A0 00        @NEXT	LDY #$00
0000F2r 1  B1 FC        	LDA (CURLNL),Y
0000F4r 1  F0 0E        	BEQ @RET
0000F6r 1  20 rr rr     	JSR PRNTLN
0000F9r 1  20 rr rr     	JSR UPDTCL
0000FCr 1               
0000FCr 1               	.if APPLE1
0000FCr 1  AD 11 D0     	LDA	KBDRDY	; any key stops the listing
0000FFr 1  10 EF        	BPL	@NEXT
000101r 1  AD 10 D0     	LDA	KBD
000104r 1               	.else
000104r 1                       LDA     ACIAStatus
000104r 1                       AND     #1
000104r 1                       BEQ     @NEXT
000104r 1                       LDA     ACIAData
000104r 1               	.endif
000104r 1  60           @RET	RTS
000105r 1               
000105r 1               ; ****************************************
000105r 1               
000105r 1               MEM
000105r 1  20 rr rr     	JSR TOEND	; set CURLNL,H to the end
000108r 1  20 rr rr     	JSR CRLF
00010Br 1  A2 04        	LDX #$04
00010Dr 1  B5 FB        @LOOP	LDA CURLNL-1,X
00010Fr 1  20 DC FF     	JSR OUTHEX
000112r 1  E0 03        	CPX #$03
000114r 1  D0 03        	BNE @SKIP
000116r 1  20 rr rr     	JSR PRDASH
000119r 1  CA           @SKIP	DEX
00011Ar 1  D0 F1        	BNE @LOOP
00011Cr 1  60           RET	RTS
00011Dr 1               
00011Dr 1               ; ****************************************
00011Dr 1               
00011Dr 1               GETARG			; get the one or two numeric arguments
00011Dr 1               			; to the list, edit, delete and insert commands
00011Dr 1               			; store them in TEMP1-4 as found
00011Dr 1               			; arg count in Y or X has FAIL
00011Dr 1  A0 00        	LDY #$00
00011Fr 1  84 30        	STY YSAV
000121r 1  A2 01        	LDX #$01
000123r 1  B5 0F        @NEXT	LDA ARGS,X
000125r 1  F0 25        	BEQ @DONE	; null terminator
000127r 1  C9 20        	CMP #SP		; find the space
000129r 1  F0 07        	BEQ @CVT
00012Br 1  C9 24        	CMP #HEX	; or $ symbol
00012Dr 1  F0 03        	BEQ @CVT
00012Fr 1  E8           	INX
000130r 1  D0 F1        	BNE @NEXT
000132r 1  E6 30        @CVT	INC YSAV	; count args
000134r 1  A9 24        	LDA #HEX
000136r 1  95 0F        	STA ARGS,X	; replace the space with '$' and convert
000138r 1  20 rr rr     	JSR CONVRT
00013Br 1               	;CPX #FAIL
00013Br 1  E8           	INX
00013Cr 1  F0 5F        	BEQ LCLERR
00013Er 1               	;INX
00013Er 1  A5 3E        	LDA LVALL
000140r 1  99 54 00     	STA TEMP1,Y
000143r 1  C8           	INY
000144r 1  A5 3F        	LDA LVALH
000146r 1  99 54 00     	STA TEMP1,Y
000149r 1  C8           	INY
00014Ar 1  D0 D7        	BNE @NEXT	; always branches
00014Cr 1  A4 30        @DONE	LDY YSAV
00014Er 1  60           	RTS		; m in TEMP1,2, n in TEMP3,4
00014Fr 1               
00014Fr 1               ; ****************************************
00014Fr 1               
00014Fr 1               EDIT
00014Fr 1  20 rr rr     	JSR GETARG
000152r 1               	;CPY #$01
000152r 1  88           	DEY
000153r 1  D0 48        	BNE LCLERR
000155r 1  20 rr rr     	JSR DELETE	; must not overwrite the command input buffer
000158r 1               ;	JMP INSERT
000158r 1               ; falls through to INSERT
000158r 1               
000158r 1               ; ****************************************
000158r 1               
000158r 1               INSERT
000158r 1  20 rr rr     	JSR GETARG	; deal with arguments if necessary
00015Br 1               	;CPX #FAIL
00015Br 1  E8           	INX
00015Cr 1  F0 3F        	BEQ LCLERR
00015Er 1               	;CPY #$00	; no args
00015Er 1  98           	TYA
00015Fr 1  D0 06        	BNE @ARGS
000161r 1  20 rr rr     	JSR TOEND	; insert at the end
000164r 1  18           	CLC
000165r 1  90 03        	BCC @IN
000167r 1  20 rr rr     @ARGS	JSR GOTOLN	; if no such line will insert at end
00016Ar 1  20 rr rr     @IN	JSR INPUT	; Get one line
00016Dr 1  E0 FF        	CPX #FAIL	; Was there an error?
00016Fr 1  F0 AB        	BEQ RET;
000171r 1               	; Save the tokenised line and update pointers
000171r 1               	; tokenised line is in IOBUF, size X
000171r 1               	; move up from CURLNL,H to make space
000171r 1  86 2F        	STX XSAV	; save X (data size)
000173r 1  A5 FD        	LDA CURLNH
000175r 1  85 51        	STA MISCH
000177r 1  85 53        	STA MISC2H
000179r 1  A5 FC        	LDA CURLNL
00017Br 1  85 50        	STA MISCL	; src in MISCL,H now
00017Dr 1  18           	CLC
00017Er 1  65 2F        	ADC XSAV
000180r 1  85 52        	STA MISC2L
000182r 1  90 02        	BCC @READY
000184r 1  E6 53        	INC MISC2H	; MISC2L,H is destination
000186r 1  20 rr rr     @READY	JSR GETSZ
000189r 1  20 rr rr     	JSR MOVEUP	; do the move
00018Cr 1  A0 00        	LDY #$00
00018Er 1               	; now move the line to the source storage area
00018Er 1               	; Y bytes, from IOBUF to CURLN
00018Er 1  B9 00 00     @MOVE	LDA IOBUF,Y
000191r 1  91 FC        	STA (CURLNL),Y
000193r 1  C8           	INY
000194r 1  C4 2F        	CPY XSAV
000196r 1  D0 F6        	BNE @MOVE
000198r 1  20 rr rr     	JSR UPDTCL	; update CURLNL,H
00019Br 1  D0 CD        	BNE @IN		; always branches
00019Dr 1               
00019Dr 1               ; ****************************************
00019Dr 1               
00019Dr 1               LCLERR			; local error wrapper
00019Dr 1               			; shared by the routines around it
00019Dr 1  4C rr rr     	JMP SHLERR
0001A0r 1               
0001A0r 1               ; ****************************************
0001A0r 1               
0001A0r 1               GETSZ			; SIZE = TEMP1,2 = lastlnL,H - MISCL,H + 1
0001A0r 1  A2 FC        	LDX #<(-$04)
0001A2r 1  B5 FE        @LOOP	LDA CURLNH+1,X
0001A4r 1  48           	PHA		; save CURLN and LINEN on the stack
0001A5r 1  E8           	INX
0001A6r 1  D0 FA        	BNE @LOOP
0001A8r 1  20 rr rr     	JSR TOEND
0001ABr 1  38           	SEC
0001ACr 1  A5 FC        	LDA CURLNL
0001AEr 1  E5 50        	SBC MISCL
0001B0r 1  85 54        	STA TEMP1
0001B2r 1  A5 FD        	LDA CURLNH
0001B4r 1  E5 51        	SBC MISCH
0001B6r 1  85 55        	STA TEMP2
0001B8r 1  E6 54        	INC TEMP1
0001BAr 1  D0 02        	BNE @SKIP
0001BCr 1  E6 55        	INC TEMP2
0001BEr 1  A2 04        @SKIP	LDX #$04
0001C0r 1  68           @LOOP2	PLA		; get CURLN and LINEN from the stack
0001C1r 1  95 F9        	STA LINEL-1,X
0001C3r 1  CA           	DEX
0001C4r 1  D0 FA        	BNE @LOOP2
0001C6r 1  60           	RTS
0001C7r 1               
0001C7r 1               ; ****************************************
0001C7r 1               
0001C7r 1               DELETE			; Delete the specified range
0001C7r 1               			; Moves from address of line arg2 (MISCL,H)
0001C7r 1               			; to address of line arg1 (MISC2L,H)
0001C7r 1  20 rr rr     	JSR GETARG
0001CAr 1               ;	CPY #$00
0001CAr 1  F0 D1        	BEQ LCLERR
0001CCr 1  84 30        	STY YSAV
0001CEr 1  20 rr rr     @DOIT	JSR GOTOLN	; this leaves TEMP1 in Y and TEMP2 in X
0001D1r 1  E0 FF        	CPX #FAIL
0001D3r 1  F0 C8        	BEQ LCLERR
0001D5r 1  A5 FC        	LDA CURLNL
0001D7r 1  85 52        	STA MISC2L
0001D9r 1  A5 FD        	LDA CURLNH
0001DBr 1  85 53        	STA MISC2H	; destination address is set in MISC2L,H
0001DDr 1  A5 30        	LDA YSAV
0001DFr 1               	;CMP #$01
0001DFr 1  4A           	LSR
0001E0r 1  F0 0C        	BEQ @INC
0001E2r 1  A6 57        	LDX TEMP4
0001E4r 1  A4 56        	LDY TEMP3	; Validate the range arguments
0001E6r 1  E4 55        	CPX TEMP2	; First compare high bytes
0001E8r 1  D0 02        	BNE @CHK	; If TEMP4 != TEMP2, we just need to check carry
0001EAr 1  C4 54        	CPY TEMP1	; Compare low bytes when needed
0001ECr 1  90 AF        @CHK	BCC LCLERR	; If carry clear, 2nd argument is too low
0001EEr 1  C8           @INC	INY		; Now increment the second argument
0001EFr 1  D0 01        	BNE @CONT
0001F1r 1  E8           	INX
0001F2r 1  86 55        @CONT	STX TEMP2
0001F4r 1  84 54        	STY TEMP1
0001F6r 1  20 rr rr     	JSR GOTOLN
0001F9r 1  A5 FC        	LDA CURLNL
0001FBr 1  85 50        	STA MISCL
0001FDr 1  A5 FD        	LDA CURLNH
0001FFr 1  85 51        	STA MISCH
000201r 1  20 rr rr     	JSR GETSZ
000204r 1               ;	JMP MOVEDN
000204r 1               ; falls through
000204r 1               
000204r 1               ; ****************************************
000204r 1               ;	Memory moving routines
000204r 1               ;  From http://www.6502.org/source/general/memory_move.html
000204r 1               ; ****************************************
000204r 1               
000204r 1               ; Some aliases for the following two memory move routines
000204r 1               
000204r 1               FROM	=MISCL		; move from MISCL,H
000204r 1               TO	=MISC2L		; to MISCL2,H
000204r 1               SIZEL	=TEMP1
000204r 1               SIZEH	=TEMP2
000204r 1               
000204r 1               MOVEDN			; Move memory down
000204r 1  A0 00        	LDY #$00
000206r 1  A6 55        	LDX SIZEH
000208r 1  F0 0E        	BEQ @MD2
00020Ar 1  B1 50        @MD1	LDA (FROM),Y ; move a page at a time
00020Cr 1  91 52        	STA (TO),Y
00020Er 1  C8           	INY
00020Fr 1  D0 F9        	BNE @MD1
000211r 1  E6 51        	INC FROM+1
000213r 1  E6 53        	INC TO+1
000215r 1  CA           	DEX
000216r 1  D0 F2        	BNE @MD1
000218r 1  A6 54        @MD2	LDX SIZEL
00021Ar 1  F0 08        	BEQ @MD4
00021Cr 1  B1 50        @MD3	LDA (FROM),Y ; move the remaining bytes
00021Er 1  91 52        	STA (TO),Y
000220r 1  C8           	INY
000221r 1  CA           	DEX
000222r 1  D0 F8        	BNE @MD3
000224r 1  60           @MD4	RTS
000225r 1               
000225r 1               MOVEUP			; Move memory up
000225r 1  A6 55        	LDX SIZEH	; the last byte must be moved first
000227r 1  18           	CLC		; start at the final pages of FROM and TO
000228r 1  8A           	TXA
000229r 1  65 51        	ADC FROM+1
00022Br 1  85 51        	STA FROM+1
00022Dr 1  18           	CLC
00022Er 1  8A           	TXA
00022Fr 1  65 53        	ADC TO+1
000231r 1  85 53        	STA TO+1
000233r 1  E8           	INX		; allows the use of BNE after the DEX below
000234r 1  A4 54        	LDY SIZEL
000236r 1  F0 0E        	BEQ @MU3
000238r 1  88           	DEY		; move bytes on the last page first
000239r 1  F0 07        	BEQ @MU2
00023Br 1  B1 50        @MU1	LDA (FROM),Y
00023Dr 1  91 52        	STA (TO),Y
00023Fr 1  88           	DEY
000240r 1  D0 F9        	BNE @MU1
000242r 1  B1 50        @MU2	LDA (FROM),Y	; handle Y = 0 separately
000244r 1  91 52        	STA (TO),Y
000246r 1  88           @MU3	DEY
000247r 1  C6 51        	DEC FROM+1	; move the next page (if any)
000249r 1  C6 53        	DEC TO+1
00024Br 1  CA           	DEX
00024Cr 1  D0 ED        	BNE @MU1
00024Er 1  60           	RTS
00024Fr 1               
00024Fr 1               ; ****************************************
00024Fr 1               
00024Fr 1               TOEND
00024Fr 1  A9 FF        	LDA #$FF
000251r 1  85 55        	STA TEMP2	; makes illegal line number
000253r 1               ;	JMP GOTOLN	; so CURLNL,H will be set to the end
000253r 1               ; falls through
000253r 1               
000253r 1               ; ****************************************
000253r 1               
000253r 1               GOTOLN			; go to line number given in TEMP1,2
000253r 1               			; sets CURLNL,H to the appropriate address
000253r 1               			; and leaves TEMP1 in Y and TEMP2 in X
000253r 1               			; if not present, return #FAIL in X
000253r 1               			; and LINEL,H will be set to the next available line number
000253r 1               EOP	= LFAIL
000253r 1               GOTIT	= LRET
000253r 1  20 rr rr     	JSR TOSTRT
000256r 1               @NXTLN			; is the current line number the same
000256r 1               			; as specified in TEMP1,2?
000256r 1               			; Z set if equal
000256r 1               			; C set if TEMP1,2 >= LINEL,H
000256r 1  A4 54        	LDY TEMP1
000258r 1  C4 FA        	CPY LINEL
00025Ar 1  D0 06        	BNE @NO
00025Cr 1  A6 55        	LDX TEMP2
00025Er 1  E4 FB        	CPX LINEH
000260r 1  F0 4B        	BEQ GOTIT
000262r 1  A0 FF        @NO	LDY #$FF
000264r 1  C8           @NXTBT	INY		; find EOL
000265r 1  B1 FC        	LDA (CURLNL),Y
000267r 1  D0 FB        	BNE @NXTBT
000269r 1  98           	TYA
00026Ar 1               	;CPY #$00
00026Ar 1  F0 3F        	BEQ EOP		; null at start of line => end of program
00026Cr 1  C8           	INY
00026Dr 1  20 rr rr     	JSR UPDTCL	; increment CURLNL,H by Y bytes
000270r 1  D0 E4        	BNE @NXTLN	; always branches
000272r 1               ;.EOP	LDX #FAIL
000272r 1               ;.GOTIT	RTS		; address is now in CURLNL,H
000272r 1               
000272r 1               ; ****************************************
000272r 1               
000272r 1               PRNTLN			; print out the current line (preserve X)
000272r 1  20 rr rr     	JSR CRLF
000275r 1  86 2F        	STX XSAV
000277r 1  20 rr rr     	JSR DETKN
00027Ar 1  C8           	INY
00027Br 1  20 rr rr     	JSR PRLNNM
00027Er 1  A2 00        	LDX #$00
000280r 1  B5 04        @PRINT	LDA LABEL,X
000282r 1  F0 06        	BEQ @DONE	; null terminator
000284r 1  20 EF FF     	JSR OUTCH
000287r 1  E8           	INX
000288r 1               	;CPX #USESZ
000288r 1  D0 F6        	BNE @PRINT
00028Ar 1  A6 2F        @DONE	LDX XSAV
00028Cr 1  60           	RTS
00028Dr 1               
00028Dr 1               ; ****************************************
00028Dr 1               
00028Dr 1               NEXTCH			; Check for valid character in A
00028Dr 1               			; Also allows direct entry to appropriate location
00028Dr 1               			; Flag success with C flag
00028Dr 1  20 rr rr     	JSR GETCH
000290r 1               	.if TABTOSPACE
000290r 1               	CMP #$09	; is it a tab?
000290r 1               	BNE @SKIP
000290r 1               	LDA #SP
000290r 1               	.endif
000290r 1  C9 20        @SKIP	CMP #SP		; valid ASCII range is $20 to $5D
000292r 1  10 1A        	BPL CHANM	; check alpha numeric entries
000294r 1  A8           	TAY
000295r 1  68           	PLA
000296r 1  68           	PLA
000297r 1  68           	PLA
000298r 1  68           	PLA		; wipe out return addresses
000299r 1  C0 08        	CPY #BS
00029Br 1  F0 3B        	BEQ INPUT	; just do it all again
00029Dr 1  C0 0D        @NOBS	CPY #CR
00029Fr 1  D0 0A        	BNE LFAIL
0002A1r 1  E0 04        	CPX #LABEL	; CR at start of LABEL means a blank line
0002A3r 1  F0 29        	BEQ DOBLNK
0002A5r 1  A9 00        	LDA #EOL
0002A7r 1  95 00        	STA IOBUF,X
0002A9r 1  F0 5C        	BEQ GOTEOL
0002ABr 1  A2 FF        LFAIL	LDX #FAIL	; may flag error or just end
0002ADr 1  60           LRET	RTS
0002AEr 1  E0 27        CHANM	CPX #LINESZ	; ignore any characters over the end of the line
0002B0r 1  10 1A        	BPL CHNO
0002B2r 1  C9 5E        	CMP #']'+1	; is character is in range $20-$5D?
0002B4r 1  10 16        	BPL CHNO	; branch to NO...
0002B6r 1  38           CHOK	SEC		; C flag on indicates success
0002B7r 1  60           	RTS
0002B8r 1  C9 2E        CHKLBL	CMP #DOT	; here are more specific checks
0002BAr 1  F0 FA        	BEQ CHOK
0002BCr 1  C9 30        CHKALN	CMP #'0'	; check alpha-numeric
0002BEr 1  30 0C        	BMI CHNO	; less than 0
0002C0r 1  C9 3A        	CMP #'9'+1
0002C2r 1  30 F2        	BMI CHOK	; between 0 and 9
0002C4r 1  C9 41        CHKLET	CMP #'A'
0002C6r 1  30 04        	BMI CHNO	; less than A
0002C8r 1  C9 5B        	CMP #'Z'+1
0002CAr 1  30 EA        	BMI CHOK	; between A and Z
0002CCr 1  18           CHNO	CLC
0002CDr 1  60           	RTS		; C flag off indicates failure
0002CEr 1               
0002CEr 1               ; ****************************************
0002CEr 1               
0002CEr 1               DOBLNK
0002CEr 1  A9 02        	LDA #BLANK
0002D0r 1  AA           	TAX		; BLANK = #$02, and that is also the
0002D1r 1  85 00        	STA IOBUF	; tokenised size of a blank line
0002D3r 1  A9 00        	LDA #EOL	; (and only a blank line)
0002D5r 1  85 01        	STA IOBUF+1
0002D7r 1  60           ENDIN	RTS
0002D8r 1               
0002D8r 1               INPUT
0002D8r 1  20 rr rr     	JSR FILLSP
0002DBr 1  A9 00        	LDA #EOL	; need this marker at the start of the comments
0002DDr 1  85 1D        	STA COMM	; for when return hit in args field
0002DFr 1  20 rr rr     	JSR CRLF
0002E2r 1  20 rr rr     	JSR PRLNNM
0002E5r 1  A2 04        	LDX #LABEL	; point to LABEL area
0002E7r 1  A9 0A        	LDA #ENDLBL
0002E9r 1  20 rr rr     	JSR ONEFLD
0002ECr 1  20 rr rr     	JSR INSSPC	; Move to mnemonic field
0002EFr 1  A5 04        	LDA LABEL
0002F1r 1  C9 3B        	CMP #CMNT
0002F3r 1  F0 0D        	BEQ @CMNT
0002F5r 1  A9 0E        	LDA #ENDMNE
0002F7r 1  20 rr rr     	JSR ONEFLD
0002FAr 1  20 rr rr     	JSR INSSPC	; Move to args field
0002FDr 1  A9 1D        	LDA #ENDARG
0002FFr 1  20 rr rr     	JSR ONEFLD
000302r 1  A9 00        @CMNT	LDA #EOL
000304r 1  20 rr rr     	JSR ONEFLD

0003C0r 1  C9 20        	CMP #SP
0003C2r 1  F0 07        	BEQ @JUMP
0003C4r 1  20 rr rr     @GET	JSR NEXTCH	; handles BS, CR and ESC
0003C7r 1  C9 20        	CMP #SP
0003C9r 1  D0 F9        	BNE @GET	; only let SP through
0003CBr 1  95 00        @JUMP	STA IOBUF,X	; insert the space
0003CDr 1  E8           	INX
0003CEr 1  4C EF FF     	JMP OUTCH
0003D1r 1               
0003D1r 1               TKNISE

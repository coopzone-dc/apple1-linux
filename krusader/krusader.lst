0003E8r 1               ; ****************************************
0003E8r 1               
0003E8r 1               DETKN			; Load a line to the IOBUF
0003E8r 1               			; (detokenising as necessary)
0003E8r 1               			; On return, Y holds tokenised size
0003E8r 1  20 rr rr     	JSR FILLSP
0003EBr 1  A0 00        	LDY #$00
0003EDr 1  A2 04        	LDX #LABEL

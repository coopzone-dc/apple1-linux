/*
 * apple1 - Apple I emulator for Linux (Debian/Ubuntu/etc.)
 *
 * Derived from the Raspberry Pi Pico Apple I emulator design:
 *   - 6502 CPU, WOZMON in ROM at $FF00, Integer BASIC ROM at $E000
 *   - Keyboard/display PIA at $D010-$D013, console on the terminal
 *     (replaces the Pico's USB serial console)
 *   - RAM everywhere except hardware: the PIA ($D010-$D01F and mirrors),
 *     the cassette area ($C000-$CFFF) and WOZMON ROM ($FF00-$FFFF)
 *   - Integer BASIC is copied into RAM at $E000 at start-up (as if loaded
 *     from tape), so it can be modified
 *   - Cassette interface emulated by a host-side "ROM" entered with C100R.
 *     The "tape" is a normal directory of files instead of an SD card.
 *
 * Build:  make        Run:  ./apple1 [-t tapedir] [-b basic.bin] [-w wozmon.bin]
 */
#define _POSIX_C_SOURCE 200809L
#define _DEFAULT_SOURCE
#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <strings.h>
#include <ctype.h>
#include <unistd.h>
#include <termios.h>
#include <poll.h>
#include <signal.h>
#include <dirent.h>
#include <errno.h>
#include <limits.h>
#include <sys/stat.h>

/* ------------------------------------------------------------------ */
/* Memory map (edit here to change the layout)                         */
/* ------------------------------------------------------------------ */
#define CASS_BASE   0xC000u     /* cassette area: not RAM, not mapped   */
#define CASS_TOP    0xCFFFu
#define BASIC_BASE  0xE000u     /* Integer BASIC image copied into RAM  */
#define BASIC_MAX   0x1000u
#define WOZ_BASE    0xFF00u     /* WOZMON ROM ($FF00-$FFFF)             */
#define ACI_ENTRY   0xC100u     /* C100R enters the tape interface      */
#define WOZ_ESCAPE  0xFF1Au     /* WOZMON ESCAPE: prints '\' and CR     */

static uint8_t mem[65536];

/* Everything is RAM except the PIA, the cassette area and the WOZMON ROM. */
static int is_ram(uint16_t a)
{
    if ((a & 0xF010) == 0xD010) return 0;            /* PIA                */
    if (a >= CASS_BASE && a <= CASS_TOP) return 0;   /* cassette interface */
    if (a >= WOZ_BASE) return 0;                     /* WOZMON ROM         */
    return 1;
}

/* WOZMON, 256 bytes (Steve Wozniak, 1976) */
static const uint8_t wozmon[] = {
